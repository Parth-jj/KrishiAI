# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret for signing JWT authentication tokens
JWT_SECRET="farmer_advisory_jwt_secret_key_2026"

# TOP_K_DOCUMENTS: Number of top agricultural chunks to retrieve for RAG context
TOP_K_DOCUMENTS="5"

# WEATHER_API_KEY: Optional API key for live weather data (falls back to agro-meteorological service)
WEATHER_API_KEY=""

# ==============================================================================
# SARVAM AI VOICE AGENTS (SAMVAAD) & TELEPHONY CONFIGURATION
# Required for real outbound AI farmer telephone calls. Never expose in frontend!
# ==============================================================================
SARVAM_API_KEY=""
SARVAM_ORG_ID=""
SARVAM_WORKSPACE_ID=""
SARVAM_AGENT_APP_ID=""
SARVAM_AGENT_APP_VERSION="1"
SARVAM_CONNECTION_ID=""
SARVAM_AGENT_PHONE_NUMBER=""

# Security secrets for verifying incoming Sarvam webhook & mid-call API tool requests
SARVAM_WEBHOOK_SECRET=""
SARVAM_TOOL_SECRET=""

# Sarvam Speech & Reasoning Models
SARVAM_STT_MODEL="saaras:v4"
SARVAM_TTS_MODEL="bulbul:v4-flash"
SARVAM_LLM_MODEL="sarvam-105b"

# Optional external telephony hangup/control credentials (e.g. Vobiz BYO SIP)
VOBIZ_AUTH_ID=""
VOBIZ_AUTH_TOKEN=""
